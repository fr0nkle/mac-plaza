# Copy to .release.env in the repository root after Apple enrollment is active.
# Keep the same team and bundle identifier across releases.
export PLAZA_TEAM_ID="${PLAZA_TEAM_ID:-YOURTEAMID}"
export PLAZA_SIGN_IDENTITY="${PLAZA_SIGN_IDENTITY:-Developer ID Application: YOUR NAME (YOURTEAMID)}"
export PLAZA_INSTALLER_IDENTITY="${PLAZA_INSTALLER_IDENTITY:-Developer ID Installer: YOUR NAME (YOURTEAMID)}"
export PLAZA_NOTARY_PROFILE="${PLAZA_NOTARY_PROFILE:-MacPlazaNotary}"
# Never put Apple passwords, API keys or private keys in this file.
