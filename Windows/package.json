{
  "name": "plaza-windows",
  "version": "0.4.0",
  "private": true,
  "description": "Plaza for Windows \u2014 shared notes with your Mac friends",
  "author": "Squid Productions",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "prepare:shared": "node scripts/prepare-shared.cjs",
    "build:engine": "node scripts/build-engine.cjs",
    "build:native": "node node_modules/node-gyp/bin/node-gyp.js rebuild --target=44.7.0 --arch=x64 --dist-url=https://electronjs.org/headers",
    "test:desktop": "node test/desktop.cjs",
    "test:parity": "node test/parity.cjs",
    "dist": "electron-builder --win nsis zip --x64 --publish never",
    "test:features": "node test/features.cjs",
    "test:updates": "node test/updates-desktop.cjs",
    "test:contracts": "node test/contracts.cjs",
    "test:shared": "node scripts/test-shared.cjs",
    "test:window": "node test/miiverse-desktop.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "node-gyp": "12.4.0"
  },
  "build": {
    "appId": "org.squidproductions.plaza.windows",
    "productName": "Plaza",
    "copyright": "Copyright \u00a9 2026 Squid Productions",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "native/runtime",
        "to": "native"
      }
    ],
    "win": {
      "icon": "src/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Plaza-Windows-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Plaza-Windows-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "include": "scripts/installer.nsh"
    }
  }
}
